# 复制为 /opt/rsgzgl/app.env 后按环境修改
# 注意：不要把含真实密码的 app.env 提交到 git

PORT=8080

# 本机 MySQL（你当前是 3307）
RSGZGL_DB_URL=jdbc:mysql://127.0.0.1:3307/gzjsgl?useUnicode=true&characterEncoding=utf8&connectionCollation=utf8mb4_0900_ai_ci&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
RSGZGL_DB_USERNAME=root
RSGZGL_DB_PASSWORD=请填写MySQL密码

# 生产管理员（务必改强密码；关闭启动时重置）
RSGZGL_ADMIN_USERNAME=admin
RSGZGL_ADMIN_PASSWORD=请填写管理员强密码
RSGZGL_ADMIN_RESET_PASSWORD=false
RSGZGL_ADMIN_DISPLAY_NAME=系统管理员

# 首次部署可 true；已有权限表后可 false
RSGZGL_SECURITY_INITIALIZE_SCHEMA=true

# 生产 / 托管 SaaS：关闭应用内签发，改用 ops 签发授权包
RSGZGL_LICENSE_ISSUE_ENABLED=false
RSGZGL_LICENSE_HMAC_SECRET=请与运维签发密钥一致

# 经 Nginx HTTPS 反代时改为 framework，并打开 Secure Cookie
# 直接 http://IP:端口 访问时保持 false，否则登录后会话 Cookie 无法写入浏览器
RSGZGL_FORWARD_HEADERS_STRATEGY=none
RSGZGL_SESSION_COOKIE_SECURE=false
RSGZGL_SESSION_COOKIE_SAME_SITE=lax

# 多客户托管开通见 ../saas/README.md

# 手机扫码上传二维码公网地址；留空则使用浏览器当前访问域名
# RSGZGL_MOBILE_UPLOAD_PUBLIC_BASE_URL=https://renshi.dxsoft.cn
