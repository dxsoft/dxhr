# 复制为 /opt/rsgzgl-ops/app.env 后按环境修改
# 不要把含真实密码的 app.env 提交到 git

PORT=18090

RSGZGL_OPS_ADMIN_USERNAME=ops
RSGZGL_OPS_ADMIN_PASSWORD=请填写运维强密码
RSGZGL_OPS_ADMIN_RESET_PASSWORD=false

# 须与人事系统 /opt/rsgzgl/app.env 中的密钥一致
RSGZGL_LICENSE_HMAC_SECRET=请与人事实例密钥一致

# 默认探测本机主实例；可在控制台再加租户
RSGZGL_OPS_MONITOR_DEFAULT_HEALTH_URL=http://127.0.0.1:8080/actuator/health
RSGZGL_OPS_MONITOR_INTERVAL_MS=30000
RSGZGL_OPS_MONITOR_HISTORY_HOURS=72
RSGZGL_OPS_MONITOR_UNITS=rsgzgl,rsgzgl@demo,rsgzgl@pq,rsgzgl@xyzzb
RSGZGL_OPS_MONITOR_CERT_HOSTS=renshi.dxsoft.cn,pq.dxsoft.cn,shpr.dxsoft.cn,xyzzb.dxsoft.cn
# RSGZGL_OPS_MONITOR_WEBHOOK=
