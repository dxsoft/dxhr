# 托管式 SaaS：单客户实例环境变量
# 复制到 /opt/rsgzgl/tenants/<tenant>/app.env 后修改
# 勿提交含真实密码的文件

PORT=18081

RSGZGL_DB_URL=jdbc:mysql://127.0.0.1:3306/gzjsgl_TENANT?useUnicode=true&characterEncoding=utf8&connectionCollation=utf8mb4_0900_ai_ci&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
RSGZGL_DB_USERNAME=rsgzgl_TENANT
RSGZGL_DB_PASSWORD=请填写库密码

RSGZGL_ADMIN_USERNAME=admin
RSGZGL_ADMIN_PASSWORD=请填写管理员强密码
RSGZGL_ADMIN_RESET_PASSWORD=false
RSGZGL_ADMIN_DISPLAY_NAME=系统管理员
RSGZGL_SECURITY_INITIALIZE_SCHEMA=true

# 生产：关闭应用内签发，授权包由 rsgzgl-ops 签发
RSGZGL_LICENSE_ISSUE_ENABLED=false
RSGZGL_LICENSE_HMAC_SECRET=请与运维签发密钥一致

# 直接 http://IP:端口 访问时保持 false（Secure=true 会导致登录即退出）
# 仅在 Nginx HTTPS 反代后再改为 framework + Secure=true
RSGZGL_FORWARD_HEADERS_STRATEGY=none
RSGZGL_SESSION_COOKIE_SECURE=false
RSGZGL_SESSION_COOKIE_SAME_SITE=lax

# UKey：云托管仍可保留；客户本机需 SoftKey 服务
RSGZGL_UKEY_ENABLED=true
RSGZGL_UKEY_REQUIRED=false
